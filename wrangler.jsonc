// wrangler.jsonc の例
{
    "name": "circle-website",
    "compatibility_date": "2026-07-25",
    "main": "./.output/server/index.mjs",
    "assets": {
        "binding": "ASSETS",
        "directory": "./.output/public/"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "your-db-name",
            "database_id": "your-database-id"
        }
    ],
    "compatibility_flags": [
        "nodejs_compat"
    ]
}