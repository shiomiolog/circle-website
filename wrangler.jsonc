// wrangler.jsonc の例
{
    "name": "circle-website",
    "compatibility_date": "2026-07-25",
    "main": "./.output/server/index.mjs",
    "assets": {
        "binding": "ASSETS",
        "directory": "./.output/public/"
    },
    // ▼ カスタムドメインの設定を追加
    "routes": [
        {
            "pattern": "circle.shiomiolog.com",
            "custom_domain": true
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "db",
            "database_id": "7d17006c-2789-4768-b861-e7bcaad80bce"
        }
    ],
    "compatibility_flags": [
        "nodejs_compat"
    ]
}